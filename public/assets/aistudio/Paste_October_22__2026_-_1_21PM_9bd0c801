// Počet dní v řadě pod denním limitem (ignoruje prázdné dny)
export function calcLimitStreak(): number {
  const dm = dailyMap(), L = state.settings.dailyLimitG || 0, t0 = startOfToday();
  let streak = 0;
  for (let i = 0; i < 400; i++) {
    const val = dm[dayKey(t0 - i * 864e5)] || 0;
    if (L > 0 && val <= L && val > 0) streak++;
    else if (val === 0) continue;
    else break;
  }
  return streak;
}

// Počet dní v řadě ÚPLNĚ bez dávky (od prvního dne s dávkou zpět)
export function calcCleanStreak(): number { /* … viz originál */ }

// Počet dní v řadě splněného vodního cíle
export function calcWaterStreak(): number {
  const goal = state.settings.dailyWaterGoalMl || 2500, t0 = startOfToday();
  const wm = {};
  state.waterLogs.forEach(w => { const k = dayKey(w.timestamp); wm[k] = (wm[k] || 0) + (w.amountMl || 0); });
  let streak = 0;
  const todayOk = (wm[dayKey(t0)] || 0) >= goal;
  for (let i = todayOk ? 0 : 1; i < 400; i++) {
    if ((wm[dayKey(t0 - i * 864e5)] || 0) >= goal) streak++;
    else break;
  }
  return streak;
}

// Počet dávek v řadě jejichž rozestup je ≥ intervalComplianceThresholdH
export function calcIntervalStreak(): number {
  const th = state.settings.intervalComplianceThresholdH || 4;
  const arr = [...state.doses].sort((a, b) => b.timestamp - a.timestamp);
  let streak = 0;
  for (let i = 0; i < arr.length - 1; i++) {
    const gapH = (arr[i].timestamp - arr[i + 1].timestamp) / 3600e3;
    if (gapH >= th) streak++;
    else break;
  }
  return streak;
}

  id: string;
  name: string;
  pricePerG: number;
  packageSizeG: number;
  mitPct: number;          // % MIT (typicky 1.45)
  sevenOhPct: number;      // % 7-OH (typicky 0.025)
  color: string;           // hex
  note: string;
  createdAt: number;       // timestamp ms
}

export interface Package {
  id: string;
  strainId: string;
  name: string;
  initialWeightG: number;
  remainingWeightG: number;
  costTotal: number;
  pricePerG: number;
  status: PackageStatus;

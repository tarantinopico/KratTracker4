  note: string;
  calibrated: boolean;
  reconciliation?: {
    date: number;
    method: ReconcileMethod;
    targetWeightG: number;
    diff: number;          // pozitivní = dávky navýšeny, negativní = sníženy
    factor: number;
    delta: number;
    doseIds: string[];
    originalAmounts: Record<string, number>;
  };
}

export interface Beverage {
  id: string;
  name: string;
  icon: string;   // emoji
  cost: number;
  note: string;
  color?: string;

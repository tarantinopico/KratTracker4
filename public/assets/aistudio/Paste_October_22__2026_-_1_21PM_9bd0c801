14. Ikony (components/icons/)

Icon.tsx – univerzální komponenta:

```tsx
interface IconProps { name: IconName; size?: number; strokeWidth?: number; className?: string; }
function Icon({ name, size = 18, strokeWidth = 1.8, className }: IconProps) {
  return (
    <svg viewBox="0 0 24 24" width={size} height={size} fill="none"
         stroke="currentColor" strokeWidth={strokeWidth}
         strokeLinecap="round" strokeLinejoin="round"
         className={className}
         style={{ verticalAlign: 'middle', display: 'inline-block', flexShrink: 0 }}
         aria-hidden="true"
         dangerouslySetInnerHTML={{ __html: ICONS[name] }} />
  );
}
```


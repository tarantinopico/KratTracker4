```typescript
export interface TBreakInfo {
  active: boolean;
  goalMs: number;
  elapsedMs: number;
  pct: number;
  remainMs: number;
  done: boolean;
  startedAt?: number;
}

export function tbreakInfo(now = Date.now()): TBreakInfo {
  const st = state.settings;
  const goalMs = (st.tbreakGoalHours || 72) * 3600e3;
  if (!st.tbreakActive || !st.tbreakStartedAt) {
    return { active: false, goalMs, elapsedMs: 0, pct: 0, remainMs: goalMs, done: false };
  }
  const elapsedMs = Math.max(0, now - st.tbreakStartedAt);
  return {
    active: true,
    goalMs,
    elapsedMs,
    pct: clamp(Math.round((elapsedMs / goalMs) * 100), 0, 100),
    remainMs: Math.max(0, goalMs - elapsedMs),
    done: elapsedMs >= goalMs,
    startedAt: st.tbreakStartedAt,
  };
}

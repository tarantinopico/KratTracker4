9.4 Farmakokinetika (lib/pharmacokinetics.ts)

Dvoufázový eliminační model s absorpční fází:

```typescript
export function calcActiveMitAtTime(targetTs: number): number {
  let active = 0;
  const { mitHalfLifeAlphaH: aH, mitHalfLifeBetaH: bH, mitTMaxH: tmaxH } = state.settings;
  state.doses.forEach(d => {
    const diffH = (targetTs - d.timestamp) / 3600000;
    if (diffH < 0 || diffH > 96) return;
    const doseMit = d.mitMg || (d.amountG * (d.mitPct || 1.45) * 10);
    let fraction: number;
    if (diffH < tmaxH) {
      fraction = Math.sin((diffH / Math.max(0.1, tmaxH)) * (Math.PI / 2));
    } else {
      const postMaxH = diffH - tmaxH;
      fraction = 0.7 * Math.pow(0.5, postMaxH / aH) + 0.3 * Math.pow(0.5, postMaxH / bH);
    }
    active += doseMit * fraction;
  });
  return r2(active);
}
```

9.5 Tolerance / Citlivost receptorů (lib/tolerance.ts)

Vrací 0–100. Startuje na 100, odečítá penalty, přičítá recovery.

```typescript
export function calcReceptorSensitivityScore(targetTs = Date.now()): number {
  const st = state.settings;
  const L = st.dailyLimitG || 10;
  const pLimit  = st.tolerancePenaltyLimit ?? 30;
  const pInt    = st.tolerancePenaltyInterval ?? 35;
  const pStreak = st.toleranceConsecutiveDaysPenalty ?? 15;
  const recPerDay = st.toleranceRecoveryPerDay ?? 15;

  let score = 100;
  const t0 = startOfDay(targetTs);
  const dayEnd = t0 + 864e5;

  const historyDoses = state.doses
    .filter(d => d.timestamp <= targetTs)
    .sort((a, b) => b.timestamp - a.timestamp);
  const todayDoses = historyDoses.filter(d => d.timestamp >= t0 && d.timestamp < dayEnd);
  const todayG = todayDoses.reduce((a, d) => a + d.amountG, 0);

  // Penalizace za krátké rozestupy (prvních 5 intervalů)
  if (historyDoses.length >= 2) {
    const intervals: number[] = [];
    for (let i = 1; i < Math.min(historyDoses.length, 6); i++) {
      intervals.push((historyDoses[i - 1].timestamp - historyDoses[i].timestamp) / 3600e3);
    }
    const avgInt = intervals.reduce((a, b) => a + b, 0) / intervals.length;
    if (avgInt < 2.5) score -= pInt;
    else if (avgInt < 4.0) score -= Math.round(pInt * 0.5);
  }

  // Penalizace za překročení denního limitu
  if (L > 0 && todayG > L) score -= pLimit;
  else if (L > 0 && todayG > L * 0.8) score -= Math.round(pLimit * 0.5);

  // Po sobě jdoucí dny s dávkou vs. čisté dny (posledních 7 dní)
  let consecutiveDays = 0, cleanDays = 0;
  for (let i = 0; i < 7; i++) {
    const s = t0 - i * 864e5, e = s + 864e5;
    const hadDose = state.doses.some(d => d.timestamp >= s && d.timestamp < e);
    if (hadDose) { if (cleanDays === 0) consecutiveDays++; }
    else         { if (consecutiveDays === 0) cleanDays++; }
  }
  if (consecutiveDays >= 7) score -= pStreak;
  else if (consecutiveDays >= 4) score -= Math.round(pStreak * 0.5);
  if (cleanDays > 0) score += cleanDays * recPerDay;

  return clamp(Math.round(score), 10, 100);
}

